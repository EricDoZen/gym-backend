{
  "name": "gym-backend",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:backup:verify": "tsx scripts/backup-verify.ts",
    "db:restore:rehearsal": "tsx scripts/restore-rehearsal.ts",
    "release:preflight": "tsx scripts/release-preflight.ts",
    "e2e:reset-rate-limits": "tsx scripts/reset-local-rate-limits.ts",
    "e2e:cleanup": "tsx scripts/cleanup-e2e.ts",
    "setup": "npm run db:check && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/swagger-ui": "^0.6.1",
    "@tidbcloud/serverless": "^0.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4",
    "jose": "^6.0.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
