PORT=8787
# TiDB Cloud Serverless — use @tidbcloud/serverless driver (HTTP), not mysql2 on port 4000
DATABASE_URL=mysql://user:password@gateway01.region.prod.alicloud.tidbcloud.com:4000/elite_gym
# Or discrete credentials (helps when the password has special URL characters):
# DB_HOST=gateway01.region.prod.alicloud.tidbcloud.com
# DB_USER=user.root
# DB_PASSWORD=password
# DB_NAME=elite_gym

# Application session secret. Production must use a unique random value >= 32 chars.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
MEMBER_JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://gym-frontend-three-psi.vercel.app

# Required only for first-time bootstrap/local seed. Never commit real passwords.
SEED_OWNER_PASSWORD=replace-with-a-strong-owner-password
SEED_RECEPTION_PASSWORD=replace-with-a-strong-reception-password
# Production seed is intentionally blocked unless this is supplied for an intentional first bootstrap:
# ALLOW_PRODUCTION_SEED=1

# Backup automation. Prefer BACKUP_KEY_BASE64 in CI/secret managers; local development may use .backup-key.
# BACKUP_KEY_BASE64=<base64-encoded-32-byte-key>
# BACKUP_DIR=C:\secure\elite-gym-backups
# BACKUP_OFFSITE_DIR=D:\offsite\elite-gym-backups

# npm test automatically derives and recreates elite_gym_test from the configured TiDB connection.
# It never uses elite_gym and removes elite_gym_test after the suite.
